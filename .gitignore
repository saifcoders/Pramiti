# ==============================================================================
# AyurEval (COGNEXA) / Pramiti - Comprehensive .gitignore
# ==============================================================================

# Environment Variables & Secrets (Keep .env.example)
.env
.env.*
!.env.example
*.env
*.env.backup
*.env.local

# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
**/venv/
**/env/

# Oversized Binaries, Executables & Tunnel Tools
*.exe
cloudflared.exe
*.dll
*.so
*.dylib
*.bin

# Logs & Diagnostics
*.log
*.log*
backend_tunnel.log
frontend_tunnel.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node & Frontend Build Artifacts
node_modules/
**/node_modules/
dist/
frontend/dist/
**/dist/
dist-ssr/
*.local

# Vector Store Cache & Databases (Raw canonical texts in data/ are preserved)
data/chroma/
backend/data/chroma/
**/data/chroma/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite

# Python Bytecode, Caches & Testing
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# IDE & Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
