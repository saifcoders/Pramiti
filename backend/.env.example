# ==============================================================================
# AyurEval Backend Environment Configuration
# ==============================================================================

# Server Settings
APP_NAME="AyurEval Verification Engine"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=ayurveda_canonical_corpus

# Embeddings & Language Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Knowledge Base Document Storage Paths
SAMHITAS_DATA_DIR=./data/samhitas
COMMENTARIES_DATA_DIR=./data/commentaries
SCIENTIFIC_DATA_DIR=./data/scientific

# Optional LLM API Providers for Verification Inference
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

